// =====================================================================
//  Nón lưỡi trai chữ nổi 2 dòng
//  Nón lưỡi trai in tên 2 dòng chữ nổi bám theo mặt cong của nón
//
//  Thân nón: mesh 3MF gốc, chỉ làm phẳng mặt ngoài vùng có chữ (bỏ đường
//  chỉ may, nếp vải) cho chữ in sắc. Bản gốc chưa sửa: than_non_goc.stl.
//  Chữ: tạo bằng text(), ép bám đúng mặt cong thật của thân nón.
//  Đơn vị: milimét. Kích thước gốc 834.7 x 507.4 x 372.3 mm.
//  Mọi thông số kích thước bên dưới tính theo kích thước gốc,
//  sau đó cả mô hình mới được nhân với ti_le.
//
//  CẦN FONT: cài Baloo2-ExtraBold-Static.ttf vào hệ thống trước khi mở
//  bằng OpenSCAD desktop (web Lab3D tự nạp font trong thư mục này).
//  Windows: chuột phải file TTF > Install.  macOS: mở bằng Font Book.
//  Linux: chép vào ~/.local/share/fonts rồi chạy  fc-cache -f
// =====================================================================


/* [Nội dung chữ] */

// Dòng trên
dong1 = "Thầy Đoàn";
// Dòng dưới
dong2 = "Dạy Lái Xe";


/* [Cỡ chữ] */

// Cỡ chữ dòng 1 (mm). Tên dài thì giảm xuống để chữ không tràn ra hông nón.
co_dong1 = 39.35;
// Cỡ chữ dòng 2 (mm)
co_dong2 = 40.69;
// Giãn cách giữa các chữ (đơn vị em). 0 là mặc định của font.
gian_chu = 0;


/* [Vị trí chữ] */

// Dời dòng 1 lên (+) hoặc xuống (-), mm
cao_dong1 = 41.62;
// Dời dòng 2 lên (+) hoặc xuống (-), mm
cao_dong2 = -42.90;
// Dời dòng 1 sang trái (+) hoặc phải (-), mm
ngang_dong1 = 0;
// Dời dòng 2 sang trái (+) hoặc phải (-), mm
ngang_dong2 = 0;


/* [Dáng chữ] */

// Chữ ôm theo mặt cong: giữ đúng bề rộng chữ trên nón, không bị kéo giãn ở hai bên
om_cong = true;
// Độ nổi của chữ so với mặt nón (mm, kích thước gốc). Nón mini (ti_le ~0.1): 3-5 cho dễ in.
do_noi = 4;
// Bán kính bo tròn mép chữ (mm). 0 = thành thẳng, đỉnh phẳng: dễ in nhất.
// Chỉ nên bo tròn (2-3.5) khi in to, ti_le từ 0.3 trở lên.
bo_tron = 0;
// Số lớp tạo phần bo tròn. Nhiều lớp thì mịn hơn nhưng render lâu hơn.
so_lop = 10;


/* [Hiển thị và xuất file] */

// Kèm thân nón (web: có trong file tải về; OpenSCAD desktop: chỉ hiện khi xem trước)
hien_than_non = true;
// Loại nón. Ecotek / Toàn Phương tự chọn tỉ lệ, bỏ qua ti_le bên dưới.
loai_non = "tuy_chinh"; // [tuy_chinh:Tùy chỉnh (theo ti_le), ecotek:Nón Ecotek (29.09% của 0.4), toan_phuong:Nón Toàn Phương (27.9% của 0.4)]
// Tỉ lệ xuất file khi loại nón là Tùy chỉnh. 1 = kích thước gốc, 0.4 = 40% (333.9 x 203.0 x 148.9 mm).
ti_le = 0.4;
// Xoay sẵn tư thế in: nón ngửa ra sau, mặt chữ hướng lên trên (in chữ sắc nhất)
xoay_tu_the_in = true;


/* [Hidden] */

// Góc xoay tư thế in [X, Y, Z] độ. Cùng thứ tự với "Rotate (absolute)" của
// Orca-Flashforge (xoay X, rồi Y, rồi Z) nên nhập y hệt số trong slicer.
XOAY_IN = [-3.35, 58.66, 86.86];

// Tỉ lệ thật dùng khi xuất: theo loại nón, hoặc ti_le nếu tùy chỉnh
TI_LE = loai_non == "ecotek"      ? 0.4 * 0.2909
      : loai_non == "toan_phuong" ? 0.4 * 0.279
      : ti_le;

// --- Hệ trục của mặt trước nón, đo trực tiếp từ mesh thân nón ---
// O0: điểm trên mặt nón, giữa mặt trước
O0 = [-129.9, 0, 230.4];
// e1: hướng đọc chữ (sang trái khi nhìn từ phía trước)
E1 = [0, -1, 0];
// e2: hướng lên trên, nằm trong mặt phẳng chữ
E2 = [0.471108, 0, 0.882075];
// nz: pháp tuyến mặt trước, hướng ra ngoài
NZ = [-0.882075, 0, 0.471108];

M = [[E1[0], E2[0], NZ[0], O0[0]],
     [E1[1], E2[1], NZ[1], O0[1]],
     [E1[2], E2[2], NZ[2], O0[2]]];

SAU = 60;    // chiều sâu khối lăng trụ chữ, đủ xuyên qua mọi lớp vỏ
CHIM = 3;    // chân chữ chìm vào vải để không hở khe với thân nón
$fn = 24;    // độ mịn nét chữ và bo tròn


// --- Mặt trước của nón, dạng lưới cao độ (đo từ mesh thân nón) ---
//  Lưới NU x NV điểm, bước BUOC mm, trong hệ trục (e1, e2, nz) ở trên.
//  LUOI_W[i][j] = độ cao mặt nón theo nz tại u = U0 + j*BUOC, v = V0 + i*BUOC.
//  Dữ liệu lưới nằm ở cuối file.
NU = 89;  NV = 49;  BUOC = 4;  U0 = -176;  V0 = -96;

function w_luoi(i, j) = LUOI_W[i][j];

// Pháp tuyến mặt nón tại nút lưới, tính bằng sai phân trung tâm
function phap_tuyen(i, j) =
    let(j0 = max(j - 1, 0), j1 = min(j + 1, NU - 1),
        i0 = max(i - 1, 0), i1 = min(i + 1, NV - 1),
        du = (w_luoi(i, j1) - w_luoi(i, j0)) / ((j1 - j0) * BUOC),
        dv = (w_luoi(i1, j) - w_luoi(i0, j)) / ((i1 - i0) * BUOC),
        n = [-du, -dv, 1])
    n / norm(n);

// Điểm cách mặt nón t mm theo pháp tuyến
function diem(i, j, t) = [U0 + j * BUOC, V0 + i * BUOC, w_luoi(i, j)] + t * phap_tuyen(i, j);

// --- Lớp vỏ dày từ a đến b mm so với mặt nón, chỉ lấy các hàng i0..i1 ---
module lop_vo(a, b, i0, i1) {
    nr = i1 - i0 + 1;
    function id(k, i, j) = k * nr * NU + (i - i0) * NU + j;
    diem_vo = [for (k = [0, 1], i = [i0 : i1], j = [0 : NU - 1]) diem(i, j, k == 0 ? a : b)];
    mat = [for (i = [i0 : i1 - 1], j = [0 : NU - 2], k = [0, 1])
              let(p = id(k, i, j), q = id(k, i + 1, j), r = id(k, i + 1, j + 1), s = id(k, i, j + 1))
              each (k == 1 ? [[p, q, r], [p, r, s]] : [[p, r, q], [p, s, r]])];
    // Cạnh biên theo chiều mặt trên, mỗi cạnh dựng thành một mặt hông
    bien = concat(
        [for (i = [i0 : i1 - 1]) [[i, 0], [i + 1, 0]]],
        [for (j = [0 : NU - 2]) [[i1, j], [i1, j + 1]]],
        [for (i = [i1 : -1 : i0 + 1]) [[i, NU - 1], [i - 1, NU - 1]]],
        [for (j = [NU - 1 : -1 : 1]) [[i0, j], [i0, j - 1]]]);
    hong = [for (e = bien)
                [id(1, e[1][0], e[1][1]), id(1, e[0][0], e[0][1]),
                 id(0, e[0][0], e[0][1]), id(0, e[1][0], e[1][1])]];
    multmatrix(M) polyhedron(diem_vo, concat(mat, hong), convexity = 4);
}

// --- Ôm cong: bảng độ dài cung dọc theo hàng v0 của mặt nón ---
//  S[j] = quãng đường đi trên mặt nón từ giữa (u = 0) đến cột j.
function hang_w(v0) =
    let(f = min(max((v0 - V0) / BUOC, 0), NV - 1.001), i = floor(f), t = f - i)
    [for (j = [0 : NU - 1]) w_luoi(i, j) * (1 - t) + w_luoi(i + 1, j) * t];
function bang_cung(v0) =
    let(w = hang_w(v0),
        ds = [for (j = [0 : NU - 2]) norm([BUOC, w[j + 1] - w[j]])],
        S = [for (j = 0, s = 0; j < NU; s = s + (j < NU - 1 ? ds[j] : 0), j = j + 1) s],
        giua = S[(NU - 1) / 2])
    [for (s = S) s - giua];

// Uốn hình 2D: trục ngang tính theo quãng đường trên mặt nón, đổi sang u.
// Chữ giữ đúng bề rộng thật khi nằm trên mặt cong thay vì bị kéo giãn ở hai bên.
module uon_ngang(v0) {
    S = bang_cung(v0);
    for (j = [0 : NU - 2]) {
        k = BUOC / (S[j + 1] - S[j]);
        multmatrix([[k, 0, 0, U0 + j * BUOC - S[j] * k], [0, 1, 0, 0], [0, 0, 1, 0]])
            intersection() {
                children();
                translate([S[j] - 0.01, -500]) square([S[j + 1] - S[j] + 0.02, 1000]);
            }
    }
}

// --- Hình 2D một dòng chữ, thụt vào `thut` mm ---
module hinh_chu(s, co, u, v, thut) {
    module goc() {
        translate([u, v])
            offset(r = -thut)
                text(s, size = co, font = "Baloo2 ExtraBold",
                     halign = "center", valign = "center",
                     spacing = 1 + gian_chu);
    }
    if (om_cong) uon_ngang(v) goc(); else goc();
}

// Khối lăng trụ chứa cả 2 dòng chữ, chiếu dọc theo pháp tuyến mặt trước
module khoi_chu(thut) {
    multmatrix(M)
        translate([0, 0, -SAU])
            linear_extrude(height = 2 * SAU, convexity = 10) {
                hinh_chu(dong1, co_dong1, ngang_dong1, cao_dong1, thut);
                hinh_chu(dong2, co_dong2, ngang_dong2, cao_dong2, thut);
            }
}

// --- Chữ nổi đầy đặn: chồng nhiều lớp vỏ mỏng bám mặt nón ---
//  Thân chữ từ -CHIM đến (do_noi - bo_tron): thành đứng, đủ cỡ.
//  Đỉnh chữ chia so_lop lớp theo cung tròn bán kính bo_tron: càng lên cao
//  chữ càng thụt vào, tạo mép tròn như chữ thêu nổi.
module chu() {
    R = min(max(bo_tron, 0), do_noi);
    h0 = do_noi - R;
    n = R > 0 ? max(round(so_lop), 1) : 0;
    tang = concat(
        [[-CHIM, h0, 0]],
        [for (k = [0 : 1 : n - 1])
            let(g0 = 90 * k / n, g1 = 90 * (k + 1) / n)
            [h0 + R * sin(g0), h0 + R * sin(g1), R * (1 - cos((g0 + g1) / 2))]]);
    // Chỉ dựng phần lưới quanh 2 dòng chữ cho nhanh
    i0 = max(floor((min(cao_dong1 - co_dong1, cao_dong2 - co_dong2) - V0) / BUOC) - 1, 0);
    i1 = min(ceil((max(cao_dong1 + co_dong1, cao_dong2 + co_dong2) - V0) / BUOC) + 1, NV - 1);
    union() {
        for (l = tang)
            intersection() {
                lop_vo(l[0], l[1], i0, i1);
                khoi_chu(l[2]);
            }
    }
}


// =====================================================================
//  KẾT QUẢ
// =====================================================================
//  Thân nón được đánh dấu % vì mesh gốc có 5739 mảnh rời và 64832 cạnh
//  hở, OpenSCAD không làm phép boolean với nó được.
//  OpenSCAD desktop: thân nón chỉ hiện khi xem trước, KHÔNG nằm trong
//  file xuất ra. Xuất chữ ra STL rồi nạp chung với than_non.stl vào
//  slicer. Hai file cùng hệ tọa độ nên tự khớp, không cần căn chỉnh.
//  Web Lab3D: tự ghép thân nón vào file tải về (không boolean, là một
//  phần riêng trong 3MF). Tắt hien_than_non nếu chỉ muốn tải phần chữ.
// =====================================================================

rotate(xoay_tu_the_in ? XOAY_IN : [0, 0, 0])
scale(TI_LE) {
    chu();
    if (hien_than_non) %import("than_non.stl", convexity = 10);
}


