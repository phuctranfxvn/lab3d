// ============================================================
//  Popsocket_Chu_Song.scad — mặt trang trí pop socket, chữ lượn sóng
//  Dựng lại dạng tham số từ 124.3mf
//  "Parametric Chunky Text Pop Socket Phone Grip Name"
//
//  Cấu tạo: đế tròn + 1–3 dòng chữ, mỗi dòng kéo giãn cho đầy bề
//  ngang rồi cả khối chữ được uốn vào hình tròn (chia thành nhiều
//  lát dọc, mỗi lát co theo chiều cao dây cung của vòng tròn).
//  Font bản gốc: Luckiest Guy. Đặt các file .ttf cùng thư mục.
//  line_layout = "original" chia dòng giống bản gốc mà vẫn điền chữ được.
//  text_mode = "original_shape" dùng đúng biên dạng chữ mẫu từ mesh.
// ============================================================

/* [Chữ] */
// "font" = điền chữ tự do; "original_shape" = biên dạng chữ mẫu cố định trích từ mesh
text_mode = "original_shape"; // ["font", "original_shape"]
num_lines = 3;      // [1, 2, 3]
line1 = "DREAM BIG";
line2 = "WORK HARD";
line3 = "SUCCEED";
font_name = "Luckiest Guy"; // ["Luckiest Guy", "Lilita One", "Cherry Bomb One", "Titan One", "Bagel Fat One", "Bevan", "Ultra"]
letter_spacing = 1.1;  // khoảng cách ký tự (1 = mặc định của font; 1.1 giống bản gốc)
word_spaces    = 1;    // số dấu cách giữa các từ (0 = dính liền)

/* [Uốn chữ vào hình tròn] */
text_area_d = 36.4;    // đường kính vùng chứa chữ (mm)
width_fill  = 0.96;    // tỉ lệ bề ngang chữ so với vùng chứa (0.5–1)
wave_amount = 1;       // 0 = không uốn (khối chữ nhật), 1 = ôm tròn, >1 = uốn mạnh hơn
line_gap    = 0.05;    // khoảng cách giữa các dòng (tỉ lệ theo bán kính vùng chữ)
// Bố cục dòng: "original" = chia chiều cao các dòng giống bản gốc (dòng dưới
// to dần ở giữa, dòng trên nhỏ lại), chỉ áp dụng khi có 3 dòng;
// "even" = các dòng cao bằng nhau
line_layout = "original"; // ["original", "even"]

/* [Kích thước] */
base_d         = 40;   // đường kính đế (mm)
base_thickness = 1;    // độ dày đế (mm)
text_height    = 4;    // chữ nổi cao (mm)
top_round      = 0;    // bo cạnh trên của chữ (mm), bản gốc ≈ 0.15. >0 render chậm trên OpenSCAD 2021
round_steps    = 4;    // số bậc tạo bo cạnh

/* [Chất lượng] */
quality = "balanced"; // ["fast", "balanced", "fine"]

/* [Hiển thị / xuất] */
// "all" = có màu; "base" / "text" để xuất STL riêng từng màu (AMS)
part = "all"; // ["all", "base", "text"]
color_base = "white";
color_text = "#E8308A";

/* [Hidden] */
use <LuckiestGuy-Regular.ttf>
use <LilitaOne-Regular.ttf>
use <CherryBombOne-Regular.ttf>
use <TitanOne-Regular.ttf>
use <BagelFatOne-Regular.ttf>
use <Bevan-Regular.ttf>
use <Ultra-Regular.ttf>

strips = quality == "fast" ? 60 : quality == "fine" ? 240 : 120;
$fn    = quality == "fast" ? 48 : quality == "fine" ? 96 : 64;
R  = text_area_d / 2;          // bán kính vùng chữ
Wx = R * width_fill;           // nửa bề ngang khối chữ
lines = [line1, line2, line3];
N = max(1, min(3, num_lines));
band = (2 - (N - 1) * line_gap) / N;   // chiều cao mỗi dòng (theo đơn vị R)

// ---------- Xử lý chuỗi ----------
function spaces(n) = n <= 0 ? "" : str(" ", spaces(n - 1));
function fix_spaces(s, i = 0, acc = "") =
    i >= len(s) ? acc :
    fix_spaces(s, i + 1, str(acc, s[i] == " " ? spaces(word_spaces) : s[i]));

// ---------- Bố cục dòng ----------
// Mỗi dòng nằm giữa một đường biên trên và một đường biên dưới.
// Vị trí biên (theo tỉ lệ nửa chiều cao vòng tròn tại cột đó) = a + b*h,
// với h = chiều cao tương đối của vòng tròn tại cột (1 ở giữa, nhỏ dần ra rìa).
// Hệ số "original" đo từ bản gốc 3 dòng.
ORIG_BOUNDS = [ [[1.101, -0.124], [-0.021, 0.466]],
                [[-0.021, 0.442], [-0.681, 0.381]],
                [[-0.613, 0.395], [-0.897, -0.174]] ];
ORIG_WIDTH  = [0.920, 0.918, 0.950];   // nửa bề ngang từng dòng so với bán kính vùng chữ

use_orig_layout = line_layout == "original" && N == 3;
function bound(i, top, h) =
    use_orig_layout
        ? ORIG_BOUNDS[i][top ? 0 : 1][0] + ORIG_BOUNDS[i][top ? 0 : 1][1] * h
          + (top ? (i > 0 ? -line_gap / 2 : 0) : (i < N - 1 ? line_gap / 2 : 0))
        : (top ? 1 - i * (band + line_gap) : 1 - i * (band + line_gap) - band);
function line_halfwidth(i) = use_orig_layout ? R * ORIG_WIDTH[i] : Wx;

// Một dòng chữ phẳng, đầy bề ngang, cao 1 đơn vị (đáy tại y=0)
module flat_line_2d(i) {
    s = fix_spaces(lines[i]);
    if (len(s) > 0)
        translate([0, 0.5]) resize([2 * line_halfwidth(i), 1])
            text(s, size = 10, font = font_name, spacing = letter_spacing,
                 halign = "center", valign = "center");
}

// ---------- Uốn vào hình tròn bằng các lát dọc ----------
function strip_h(x) = pow(max(0, 1 - pow(x / R, 2)), wave_amount / 2);

module warped_text_2d() {
    if (text_mode == "original_shape") original_text_2d();
    else {
        Xmax = max([for (i = [0 : N - 1]) line_halfwidth(i)]);
        dx = 2 * Xmax / strips;
        for (k = [0 : strips - 1]) {
            x0 = -Xmax + k * dx;
            h  = strip_h(x0 + dx / 2);
            for (i = [0 : N - 1]) {
                yt = R * h * bound(i, true,  h);
                yb = R * h * bound(i, false, h);
                if (yt > yb)
                    intersection() {
                        translate([x0, -R - 1]) square([dx + 0.001, 2 * R + 2]);
                        translate([0, yb]) scale([1, yt - yb]) flat_line_2d(i);
                    }
            }
        }
    }
}

// chữ không bao giờ tràn ra ngoài đế
module text_2d()
    intersection() {
        warped_text_2d();
        circle(d = base_d - 0.4, $fn = 120);
    }

// ---------- 3D ----------
module base() cylinder(d = base_d, h = base_thickness, $fn = 120);

module text_layer() {
    r = min(top_round, text_height);
    translate([0, 0, base_thickness]) {
        linear_extrude(text_height - r) text_2d();
        if (r > 0)
            for (j = [1 : round_steps]) {
                a0 = 90 * (j - 1) / round_steps;
                a1 = 90 * j / round_steps;
                z0 = text_height - r + r * sin(a0);
                z1 = text_height - r + r * sin(a1);
                translate([0, 0, z0 - 0.001]) linear_extrude(z1 - z0 + 0.001)
                    offset(delta = -r * (1 - cos(a1))) text_2d();
            }
    }
}

if (part == "all") {
    color(color_base) base();
    color(color_text) text_layer();
}
else if (part == "base") base();
else if (part == "text") text_layer();

