// ============================================================
//  Móc khoá Fabio
//  Móc khoá tên kiểu chữ Minecraft, 2 lớp, in được 2 màu (AMS)
//
//  Minecraft_Example.scad — dựng lại dạng tham số từ Minecraft_Example.3mf
//  "Minecraft Keychain Customizable"
//  Giá trị mặc định tái tạo bản gốc "FABIO".
//
//  FONT: bản gốc dùng font kiểu logo Minecraft (có vết nứt),
//  nhiều khả năng là "Minecrafter" (Craftron Gaming, miễn phí cho
//  mục đích cá nhân). Cần cài font vào máy để dùng text_mode = "font".
//  text_mode = "original" dùng đúng biên dạng chữ FABIO trích từ mesh,
//  không cần font.
// ============================================================

/* [Chữ] */
text_mode   = "font"; // ["font", "original"]
name_text   = "FABIO";
font_name   = "Minecrafter";
text_height = 10.04;  // chiều cao chữ thực tế (mm) — chữ tự co giãn theo giá trị này
text_spacing = 1.0;   // khoảng cách ký tự

/* [Kích thước] */
base_thickness = 6;     // độ dày đế (mm)
text_inset     = 1;     // chữ ăn sâu vào đế (mm) — để màu chữ liền khối
text_raise     = 1.01;  // chữ nhô lên khỏi đế (mm)
base_offset    = 2.5;   // đế nở ra quanh chữ (mm)
fill_letter_holes = false; // lấp lỗ kín còn sót trong đế (bản gốc: không cần)
// "auto" dùng fill() nếu OpenSCAD hỗ trợ; "closing" cho OpenSCAD 2021 (gần đúng)
fill_method = "auto"; // ["auto", "fill", "closing"]
closing_radius = 2;

/* [Vòng móc khóa] */
ring_x       = -4.2934; // tâm lỗ so với mép trái chữ (mm)
ring_y       = 3.3403;  // tâm lỗ so với tâm dọc của chữ (mm)
ring_outer_d = 9.5;     // đường kính vòng (mm)
ring_hole_d  = 5.5;     // đường kính lỗ (mm)

/* [Hiển thị / xuất] */
// "all" = toàn bộ có màu; "base" / "text" để xuất STL riêng từng màu (AMS)
part = "all"; // ["all", "base", "text"]
color_base = "#2B2B2B";
color_text = "#0E8A12";
resolution = 64;

/* [Hidden] */
$fn = resolution;

// ---------- 2D ----------
// Chữ đặt mép trái tại x≈0, tâm dọc tại y=0, cao đúng text_height
module text_2d() {
    if (text_mode == "original") original_text_2d();
    else resize([0, text_height], auto = true)
        text(name_text, size = 10, spacing = text_spacing, font = font_name,
             halign = "left", valign = "center");
}

module fill_holes() {
    if (!fill_letter_holes) children();
    else if (fill_method == "fill" || (fill_method == "auto" && version_num() >= 20240101))
        fill() children();
    else
        offset(r = -closing_radius) offset(r = closing_radius) children();
}

// Như bản gốc: lỗ chỉ khoét trên vòng móc, phần đế quanh chữ phủ lên sau
module footprint_2d() union() {
    translate([ring_x, ring_y]) difference() {
        circle(d = ring_outer_d);
        circle(d = ring_hole_d);
    }
    fill_holes() offset(r = base_offset) text_2d();
}

// ---------- 3D ----------
module base() difference() {
    linear_extrude(base_thickness) footprint_2d();
    translate([0, 0, base_thickness - text_inset])
        linear_extrude(text_inset + 1) text_2d();
}
module text_layer()
    translate([0, 0, base_thickness - text_inset])
        linear_extrude(text_inset + text_raise) text_2d();

if (part == "all") {
    color(color_base) base();
    color(color_text) text_layer();
}
else if (part == "base") base();
else if (part == "text") text_layer();

