// ============================================================
//  Recessed_Heart_Keyring.scad — móc khóa tên, trái tim và ô chữ lõm
//  Dựng lại dạng tham số từ Recessed_Heart_Keyring_Bambu.3mf
//  "Personalised Recessed Heart Name Keyring"
//
//  Cấu tạo (như bản gốc): tấm đáy màu (lộ ra ở đáy trái tim và ô chữ)
//  + khung trên có khoét trái tim, ô chữ + chữ nổi đặt trong ô.
//
//  FONT: bản gốc dùng "1000 Wishes Origami" (chữ đậm, bật Bold trong
//  Bambu Studio). Cần cài font này để dùng text_mode = "font"; nếu
//  không có, đổi font_name sang font khác bạn có.
//  text_mode = "original" dùng đúng biên dạng chữ của 3 tên mẫu.
// ============================================================

/* [Chữ] */
text_mode   = "font"; // ["font", "original"]
name_text   = "Maleah";
font_name   = "1000 Wishes Origami";
// Cách định cỡ chữ: "height" = co giãn cho cao đúng text_height,
// "width" = co giãn cho rộng đúng text_width, "size" = dùng cỡ font text_size
text_fit    = "height"; // ["height", "width", "size"]
text_height = 22;    // mm (bản gốc: 19–24 mm tùy tên)
text_width  = 70;    // mm (ô chữ rộng 77 mm)
text_size   = 20;    // cỡ font khi text_fit = "size"
text_bold   = 0;     // làm đậm thêm nét (mm), 0 = giữ nguyên font
text_dx     = 0;     // dịch chữ trong ô (mm)
text_dy     = 0;
// Chỉ dùng khi text_mode = "original"
original_name = "MALEAH"; // ["MALEAH", "EILIDH-ROSE", "RENNEIGH"]

/* [Thân móc khóa] */
tag_length   = 120;
tag_width    = 32;
tag_corner_r = 6;
floor_thickness = 3.2;  // tấm đáy màu (mm)
frame_height    = 2;    // khung trên = độ sâu phần lõm (mm)

/* [Ô chữ lõm] */
panel_x0 = -20.5;   // mép trái ô chữ (gốc tọa độ ở tâm móc khóa)
panel_x1 = 56.5;    // mép phải
panel_h  = 27;      // chiều cao ô
panel_r  = 2.5;     // bo góc ô

/* [Trái tim lõm] */
heart_x    = -38;
heart_y    = 0;
heart_size = 20.5;  // chiều rộng = chiều cao trái tim (mm)

/* [Lỗ móc] */
hole_x = -54;
hole_y = 0;
hole_d = 6;

/* [Chữ 3D] */
text_thickness = 2.2;   // độ dày khối chữ (mm)
text_embed     = 0.015; // chữ ăn vào tấm đáy (mm); chữ nhô hơn khung 0.185 mm như bản gốc

/* [Hiển thị / xuất] */
// "all" = có màu; xuất STL riêng từng phần cho AMS
part = "all"; // ["all", "floor", "frame", "text", "frame_and_text"]
color_floor = "#F4A7C3";
color_frame = "white";
color_text  = "white";
resolution  = 64;

/* [Hidden] */
$fn = resolution;
panel_cx = (panel_x0 + panel_x1) / 2;

// ---------- 2D ----------
module rounded_rect(x0, y0, x1, y1, r)
    translate([x0 + r, y0 + r]) offset(r = r) square([x1 - x0 - 2*r, y1 - y0 - 2*r]);

module tag_2d() difference() {
    rounded_rect(-tag_length/2, -tag_width/2, tag_length/2, tag_width/2, tag_corner_r);
    translate([hole_x, hole_y]) circle(d = hole_d);
}
module panel_2d() rounded_rect(panel_x0, -panel_h/2, panel_x1, panel_h/2, panel_r);
module heart_shape_2d()
    translate([heart_x, heart_y]) scale(heart_size / 20.5) heart_profile_2d();

module text_font_2d()
    text(name_text, size = text_fit == "size" ? text_size : 10, font = font_name,
         halign = "center", valign = "center");

module text_2d() {
    if (text_mode == "original") {
        if (original_name == "EILIDH-ROSE") text_eilidh_rose_2d();
        else if (original_name == "RENNEIGH") text_renneigh_2d();
        else text_maleah_2d();
    } else translate([panel_cx + text_dx, text_dy]) offset(delta = text_bold) {
        if (text_fit == "height") resize([0, text_height], auto = true) text_font_2d();
        else if (text_fit == "width") resize([text_width, 0], auto = true) text_font_2d();
        else text_font_2d();
    }
}

// ---------- 3D ----------
module floor_part() linear_extrude(floor_thickness) tag_2d();
module frame_part()
    translate([0, 0, floor_thickness]) linear_extrude(frame_height)
        difference() { tag_2d(); panel_2d(); heart_shape_2d(); }
module text_part()
    translate([0, 0, floor_thickness - text_embed]) linear_extrude(text_thickness)
        intersection() { text_2d(); panel_2d(); }   // giữ chữ trong ô

if (part == "all") {
    color(color_floor) floor_part();
    color(color_frame) frame_part();
    color(color_text)  text_part();
}
else if (part == "floor") floor_part();
else if (part == "frame") frame_part();
else if (part == "text")  text_part();
else if (part == "frame_and_text") { frame_part(); text_part(); }

